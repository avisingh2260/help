version: '3.8'

services:
  # Redis Master
  redis-master:
    image: redis:6.0.6
    container_name: redis-master
    command: redis-server --port 6379 --appendonly yes --protected-mode no
    ports:
      - "6379:6379"
    volumes:
      - redis-master-data:/data
    networks:
      - redis-network

  # Redis Replica 1
  redis-replica-1:
    image: redis:6.0.6
    container_name: redis-replica-1
    command: redis-server --port 6379 --replicaof redis-master 6379 --appendonly yes --protected-mode no
    ports:
      - "6380:6379"
    depends_on:
      - redis-master
    volumes:
      - redis-replica1-data:/data
    networks:
      - redis-network

  # Redis Replica 2
  redis-replica-2:
    image: redis:6.0.6
    container_name: redis-replica-2
    command: redis-server --port 6379 --replicaof redis-master 6379 --appendonly yes --protected-mode no
    ports:
      - "6381:6379"
    depends_on:
      - redis-master
    volumes:
      - redis-replica2-data:/data
    networks:
      - redis-network

  # Sentinel 1
  redis-sentinel-1:
    image: redis:6.0.6
    container_name: redis-sentinel-1
    command: >
      bash -c "echo 'port 26379
      dir /tmp
      sentinel monitor mymaster redis-master 6379 2
      sentinel down-after-milliseconds mymaster 5000
      sentinel parallel-syncs mymaster 1
      sentinel failover-timeout mymaster 10000
      bind 0.0.0.0
      protected-mode no' > /tmp/sentinel.conf && redis-sentinel /tmp/sentinel.conf"
    ports:
      - "26379:26379"
    depends_on:
      - redis-master
      - redis-replica-1
      - redis-replica-2
    networks:
      - redis-network

  # Sentinel 2
  redis-sentinel-2:
    image: redis:6.0.6
    container_name: redis-sentinel-2
    command: >
      bash -c "echo 'port 26379
      dir /tmp
      sentinel monitor mymaster redis-master 6379 2
      sentinel down-after-milliseconds mymaster 5000
      sentinel parallel-syncs mymaster 1
      sentinel failover-timeout mymaster 10000
      bind 0.0.0.0
      protected-mode no' > /tmp/sentinel.conf && redis-sentinel /tmp/sentinel.conf"
    ports:
      - "26380:26379"
    depends_on:
      - redis-master
      - redis-replica-1
      - redis-replica-2
    networks:
      - redis-network

  # Sentinel 3
  redis-sentinel-3:
    image: redis:6.0.6
    container_name: redis-sentinel-3
    command: >
      bash -c "echo 'port 26379
      dir /tmp
      sentinel monitor mymaster redis-master 6379 2
      sentinel down-after-milliseconds mymaster 5000
      sentinel parallel-syncs mymaster 1
      sentinel failover-timeout mymaster 10000
      bind 0.0.0.0
      protected-mode no' > /tmp/sentinel.conf && redis-sentinel /tmp/sentinel.conf"
    ports:
      - "26381:26379"
    depends_on:
      - redis-master
      - redis-replica-1
      - redis-replica-2
    networks:
      - redis-network

volumes:
  redis-master-data:
  redis-replica1-data:
  redis-replica2-data:

networks:
  redis-network:
    driver: bridge
